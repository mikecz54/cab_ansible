MyProgram.LogMsg('.')
MyProgram.LogMsg('. RedHat OS User Audit.')
MyProgram.LogMsg('. =====================')
MyProgram.LogMsg('.')

MyProgram.LogMsg('.')
MyProgram.LogMsg('. Declaring Static Arrays .....')

MyServerList=['usldynagt11',     'psldynagt11',       'psldynagt12',    'psldynsyn11', \
              'usldynagt21',     'usldynsyn21',       'psldynagt21',    'psldynagt22', 'psldynsyn21', \
              'cab-ltc-praeng',  'cab-ltc-ntp',       'cab-tc2-praeng', 'cab-tc2-ntp', \
              'psldelpem11',     'psldelpem11',   \
              'cab-prod-syslog', 'cab-prod-repo', \
              'cab-uat-amm-db',  'cab-uat-amm-app', \
              'cab-uat-cbs-db',  'cab-uat-cbs-app2',  'cab-uat-cbsig', \
#             'cab-uat2-cbs-db', \
              'cab-uat2-cbs-app2', \
              'cab-prod-dbvc',   'cab-prod-dbvdb', \
              'cab-prod-amm-db', 'cab-prod-amm-app', \
              'cab-prod-cbs-db', 'cab-prod-cbs-app2', 'cab-prod-cbsig', \
              'cab-prod-infral' ]

MyInfraSupport = ['rmagistrelli', 'adikko', 'amina', 'mczerniak', 'aalbakri' ]
MyAppSupport   = ['dbenjamin', 'rgame', 'skarunakaran', 'amohamed', 'eahmad', 'cab_prdsup_appsup', 'cab_prdsrv_appsup' ]
MyDynSupport   = ['mwright', 'aponnampala' ]

MyPPT = ['ppt' ]
MyDSP = ['dsp_dba_admin', 'vensup_dsp_dba' ]
MySLUsers = ['vladimir' ]

MySLApp = ['ifagent', 'jboss', 'opendj', 'ispops', 'jboss3', 'ispops3', 'cbsig3', 'cbsig1', 'cbsig2', 'cbsig4', 'catalina', 'dxc' ]

MyDynatraceApp = ['dtuserag', 'dtuser' ]
MyTenableApp   = ['tenabletag', 'tenable_tua_comm', 'svc_tenable' ]
MySophosApp    = ['sophos-spl-user', 'sophos-spl-local', 'sophos-spl-updatescheduler', 'sophos-spl-av', 'sophos-spl-threat-detector' ]
MyDelineaApp   = ['delinea' ]

MyOracleApp    = ['oracle' ,'operdba', 'cab_dba' ]
MyInfraApp     = ['mysql', 'caddy', 'cab_ansible', 'veeam-usr-deploymentvcp', 'veeam-usr-transportsvc', 'qemu', 'cabansible' ]

MyLinuxCore    = ['root', 'bin', 'daemon', 'adm', 'sync', 'shutdown', 'halt', 'operator', 'nobody', 'lp', 'systemd-coredump', 'dbus', 'systemd-resolve' ]
MyLinuxAdds    = ['chrony', 'sshd' ]
MyLinuxCoreNA  = ['games', 'ftp', 'ntp', 'fapolicyd', 'mail', 'tss', 'unbound', 'polkitd', 'rpc', 'rpcuser', 'postfix', 'sssd', 'rtkit', 'pipewire', 'avahi', 'geoclue', 'flatpak', 'apache', 'nagios', 'nginx', 'systemd-network', 'libstoragemgmt', 'gluster', 'usbmuxd', 'radvd', 'colord', 'abrt', 'saslauth', 'saned', 'pulse', 'gdm', 'setroubleshoot', 'gnome-initial-setup', 'tcpdump', 'nfsnobody', 'dnsmasq', 'cockpit-ws', 'cockpit-wsinstance', 'mailnull', 'smmsp', 'clevis', 'stapunpriv', 'prodsre', 'jtovarys', 'openscap' ]

MyProgram.LogMsg('.')
MyProgram.LogMsg('. Declaring User Keys And Values Array .....')
MyHostArrayKeys = []
MyHostArrayValues = []

for MyProgram_Hostname in MyServerList:
  MyHostArrayKeys.append(MyProgram_Hostname)
  MyHostArrayValues.append(None)

MyProgram.LogMsg('. Declaring User Matrix .....')
MyProgram.LogMsg('.')

MyUserMatrix = {}
MyUserMatrix['USERNAMES'] = []
MyUserMatrix['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring User Infra Accounts Array .....')
MyReportUserInfra = {}
MyReportUserInfra['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring User App Support Accounts Array .....')
MyReportUserAppSup = {}
MyReportUserAppSup['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring User Dynatrace Support Accounts Array .....')
MyReportUserDynSupp = {}
MyReportUserDynSupp['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring User PPT Support Accounts Array .....')
MyReportUserPPT = {}
MyReportUserDynSupp['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring User DSP Support Accounts Array .....')
MyReportUserDSP = {}
MyReportUserDynSupp['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Application Dynatrace Accounts Array .....')
MyReportAppDyna = {}
MyReportAppDyna['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Application Tenable Accounts Array .....')
MyReportAppTenable = {}
MyReportAppTenable['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Application Delinea Accounts Array .....')
MyReportAppDelinea = {}
MyReportAppDelinea['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Application Sophos Accounts Array .....')
MyReportAppSophos = {}
MyReportAppSophos['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Application Oracle Accounts Array .....')
MyReportAppOracle = {}
MyReportAppOracle['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Application Infra Specific Accounts Array .....')
MyReportAppInfra = {}
MyReportAppInfra['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring OS CORE Accounts Array .....')
MyReportOSCore = {}
MyReportOSCore['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring OS Package Accounts Array .....')
MyReportOSPackage = {}
MyReportOSPackage['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring OS Optional Accounts Array .....')
MyReportOSOptional = {}
MyReportOSOptional['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring SilverLake Support Accounts Array .....')
MyReportSLUsers = {}
MyReportSLUsers['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring SilverLake (CBS) Application Accounts Array .....')
MyReportSLApp = {}
MyReportSLApp['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)

MyProgram.LogMsg('. Declaring Undefined Accounts Array .....')
MyReportUndefined = {}
MyReportUndefined['USERNAMES'] = copy.deepcopy(MyHostArrayKeys)


for MyProgram_Hostname in MyServerList:
  # -------------------------------------------------------------------------------------------------------------------------
  # --- Test Connection To Host                                                                                           ---
  # -------------------------------------------------------------------------------------------------------------------------
  MyProgram.LogMsg('.')
  MyProgram.LogMsg('. Connecting To Host : [' + MyProgram_Hostname + '] .....')
  try :
    MySHObject = MySSH(MyProgram_Hostname)
    MySSH_ConnectionGood = MySHObject.RunCommand('hostname')
  except SSHFailedToConnect as MyException:
    raise SSHFailedToConnect()
  except SSHBadCommand as MyException:
    raise SSHBadCommand()
  except SSHProgramFailed as MyException:
    raise SSHProgramFailed()

  # -------------------------------------------------------------------------------------------------------------------------
  # --- Do The Repostory Checks                                                                                           ---
  # -------------------------------------------------------------------------------------------------------------------------
  MyProgram.LogMsg('. Gathering OS User Accounts .....')
  try :
    MySHObject = MySSH(MyProgram_Hostname)
    MySSH_RepoStatus = MySHObject.RunCommand('cat /etc/passwd')
  except SSHFailedToConnect as MyException:
    raise SSHFailedToConnect()
  except SSHBadCommand as MyException:
    raise SSHBadCommand()
  except SSHProgramFailed as MyException:
    raise SSHProgramFailed()
  else:
    for line in MySSH_RepoStatus:
      ThisUser = line.split(':')
      ThisUser = str(ThisUser[0])

      if ThisUser in MyUserMatrix:
        MyProgram.LogMsg('.  Processing User : [' + ThisUser + '] - EXISTING USER !!')
        HostOffset = MyHostArrayKeys.index(MyProgram_Hostname)
        ThisMatrixRow = MyUserMatrix[ThisUser]
        ThisMatrixRow[HostOffset] = 'Y'
        MyUserMatrix[ThisUser] = ThisMatrixRow

      else:
        MyProgram.LogMsg('.  Processing User : [' + ThisUser + '] - NEW USER !!')
        HostOffset = MyHostArrayKeys.index(MyProgram_Hostname)
        ThisMatrixRow = copy.deepcopy(MyHostArrayValues)
        ThisMatrixRow[HostOffset] = 'Y'
        MyUserMatrix[ThisUser] = ThisMatrixRow

# -------------------------------------------------------------------------------------------------------------------------
# --- Now Populate The Report Arrays                                                                                    ---
# -------------------------------------------------------------------------------------------------------------------------
MyProgram.LogMsg('.')
MyProgram.LogMsg('. Populating Reporting Structures With Data .....')
for MyReportUser in MyUserMatrix:
   WrkUsername = MyReportUser
   WrkUserperms = MyUserMatrix[MyReportUser]

   # Now do a big if for each arrary.....
   if   any( x == WrkUsername for x in MyInfraSupport):
     MyReportUserInfra[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyAppSupport):
     MyReportUserAppSup[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyDynSupport):
     MyReportUserDynSupp[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyPPT):
     MyReportUserPPT[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyDSP):
     MyReportUserDSP[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MySLUsers):
     MyReportSLUsers[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyDynatraceApp):
     MyReportAppDyna[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyTenableApp):
     MyReportAppTenable[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MySophosApp):
     MyReportAppSophos[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyDelineaApp):
     MyReportAppDelinea[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyOracleApp):
     MyReportAppOracle[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MySLApp):
     MyReportSLApp[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyInfraApp):
     MyReportAppInfra[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyLinuxCore):
     MyReportOSCore[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyLinuxCoreNA):
     MyReportOSOptional[WrkUsername] = copy.deepcopy(WrkUserperms)
   elif any( x == WrkUsername for x in MyLinuxAdds):
     MyReportOSPackage[WrkUsername] = copy.deepcopy(WrkUserperms)
   else:
     MyReportUndefined[WrkUsername] = copy.deepcopy(WrkUserperms)

# -------------------------------------------------------------------------------------------------------------------------
# --- Generate The Report Output File                                                                                   ---
# -------------------------------------------------------------------------------------------------------------------------
MyProgram.LogMsg('.')
MyProgram.LogMsg('. Creating Report .....')

# under the reports/audits directory
# now check / create the todays date directory
# open a file for write called linux-os-accounts....... etc etc etc

TMP_DirectoryBase = '/home/cab_ansible/CAB_ADMIN/reports/audits'
TMP_DateTime = datetime.datetime.fromtimestamp(MyProgram.INT_RuntimeValues['SYSTEM-STARTTIMEUTC']).strftime('%Y-%m-%d')
TMP_NewPath = TMP_DirectoryBase + '/' + TMP_DateTime

os.makedirs(TMP_NewPath, exist_ok=True)

ReportFilename = 'linux-os-accounts.txt'
