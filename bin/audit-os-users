MySummaryReport.write('\n')

for MyPrintRow in MyReportOSOptional:
  MyProgram.LogMsg('.    ' + str(MyPrintRow) + ' :: ' + str(MyReportOSOptional[MyPrintRow]) )
  MySummaryReport.write(str(MyPrintRow) + ' : ' + str(MyReportOSOptional[MyPrintRow]) + '\n')
  if str(MyPrintRow) != 'USERNAMES':
    MySummaryWRK.write('OS-OPTPKG , ' +  str(MyPrintRow) + ' , ' + str(MyReportOSOptional[MyPrintRow]) + '\n')

# INDEFINED Accounts - BAD
# -------------------------------------------------------------------------------------------------------------------------
MyProgram.LogMsg('.')
MyProgram.LogMsg('. UNDEFINED ACCOUNTS')
MyProgram.LogMsg('.')

MySummaryReport.write('\n')
MySummaryReport.write('UNDEFINED ACCOUNTS\n')
MySummaryReport.write('------------------\n')
MySummaryReport.write('\n')

for MyPrintRow in MyReportUndefined:
  MyProgram.LogMsg('.    ' + str(MyPrintRow) + ' :: ' + str(MyReportUndefined[MyPrintRow]) )
  MySummaryReport.write(str(MyPrintRow) + ' : ' + str(MyReportUndefined[MyPrintRow]) + '\n')
  if str(MyPrintRow) != 'USERNAMES':
    MySummaryWRK.write('UNDEFINED , ' +  str(MyPrintRow) + ' , ' + str(MyReportUndefined[MyPrintRow]) + '\n')

MySummaryReport.write('\n')
MySummaryReport.write('***** END OF REPORT *****\n')
MySummaryReport.close()

MySummaryWRK.close()

# -------------------------------------------------------------------------------------------------------------------------
# --- Correctly Format The Report to be a CSV file                                                                      ---
# -------------------------------------------------------------------------------------------------------------------------
MyCMDFormat = ' | sed -e !s/\[//g! | sed -e !s/\]//g! | sed -e !s/None/ /g! | sed -e "s/~Y~/Y /g"'

MyProgram.LogMsg('DEBUG:' + str(MyCMDFormat) )

MyCMDFormat = MyCMDFormat.replace('~Y~', "'Y'")
MyCMDFormat = MyCMDFormat.replace('!', "'")

MyProgram.LogMsg('DEBUG:' + str(MyCMDFormat) )

MyCMDFormat = 'cat ' + str(MyWRKReport) + str(MyCMDFormat) + ' > ' + str(MyCSVReport)

os.system(MyCMDFormat)

# -------------------------------------------------------------------------------------------------------------------------
# --- Program Finished - Terminating Now                                                                                ---
# -------------------------------------------------------------------------------------------------------------------------
MyProgram.LogMsg('.')
MyProgram.LogMsg('. Terminating Program .....')
MyProgram.LogMsg('.')
MyProgram.LogMsg('.')
MyProgram.Terminate()
